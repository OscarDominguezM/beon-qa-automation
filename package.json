{
  "name": "beon-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "BEON QA Automation Exercise",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:headed": "playwright test --project=ui --headed",
    "test:headless": "playwright test",
    "ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
